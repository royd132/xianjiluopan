# Mock mode needs no key. Real mode requires Qwen and the local public-data cache.
FORESIGHT_DATA_MODE=mock
VITE_API_URL=http://localhost:8000
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAX_REVIEWS=20
QWEN_TIMEOUT_SEC=60
# Optional: enables current Brazil competitor listings and price evidence.
MERCADO_LIVRE_ACCESS_TOKEN=
# SellerSprite API secret-key for Amazon product/market research.
SELLERSPRITE_SECRET_KEY=
# SellerSprite CLI project env also uses SELLERSPRITE_KEY; the backend accepts either name.
SELLERSPRITE_KEY=
# Set to mcp to make the backend research adapter call the official MCP server.
SELLERSPRITE_TRANSPORT=mcp
SELLERSPRITE_MCP_FALLBACK_REST=true
# Google Trends Alpha access is currently limited; set only after receiving an API key.
GOOGLE_TRENDS_API_KEY=
